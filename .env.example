# === OpenRouter (required) ===
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Comma-separated free models (shared fallback). Tried in order on 429 / outages.
# Updated to Sep 2026 live OpenRouter free endpoints (top usage + JSON-capable).
OPENROUTER_MODELS=minimax/minimax-m3:free,nvidia/nemotron-3-ultra-550b-a55b:free,poolside/laguna-s-2.1:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-super-120b-a12b:free,inclusionai/ling-3.0-flash-fin:free,minimax/minimax-m2.7:free,google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,poolside/laguna-xs-2.1:free,z-ai/glm-5.2:free,openrouter/free

# Optional task-specific preference lists (tried first, then OPENROUTER_MODELS)
# OPENROUTER_MODELS_MACRO=nvidia/nemotron-3.5-lightning:free,minimax/minimax-m3:free,google/gemma-4-26b-a4b-it:free
# OPENROUTER_MODELS_ANALYST=nvidia/nemotron-3-ultra-550b-a55b:free,minimax/minimax-m3:free,nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Email destination (required) ===
EMAIL_TO=you@example.com
EMAIL_FROM=Value Alerts <alerts@yourdomain.com>

# === Option A: Resend HTTP API (recommended for GitHub Actions) ===
RESEND_API_KEY=re_xxxxxxxx

# === Option B: Gmail / generic SMTP (used when RESEND_API_KEY is empty) ===
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password

# === Screening thresholds (optional overrides) ===
MAX_DEBT_TO_EQUITY=0.5
MIN_ROE=15.0
MIN_MARGIN_OF_SAFETY_PCT=20.0
MAX_SECTORS=2
MAX_CANDIDATES_PER_SECTOR=8
MAX_ANALYST_CANDIDATES=5

# === Soft-guide entry timing (optional; never blocks ALERT) ===
# ENTRY_GAP_PCT=2.0
# ENTRY_FALLING_5D_PCT=-8.0
# ENTRY_FALLING_20D_PCT=-15.0
# ENTRY_CAUTION_5D_PCT=-4.0

# === Runtime ===
# Email a weekly digest even when no MoS alerts fire
DIGEST_WHEN_EMPTY=false
# Skip outbound email (local testing)
DRY_RUN=false
LOG_LEVEL=INFO
ARTIFACT_DIR=artifacts
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=90
